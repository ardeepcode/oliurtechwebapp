# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase configuration for Firestore database
# Set either FIREBASE_SERVICE_ACCOUNT_PATH or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
FIREBASE_SERVICE_ACCOUNT_PATH="path/to/serviceAccountKey.json"
# GOOGLE_APPLICATION_CREDENTIALS="path/to/serviceAccountKey.json"

# AWS DynamoDB configuration
AWS_REGION="us-east-1"
AWS_TABLE_NAME="OliurTechTable"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
# AWS_SESSION_TOKEN="optional-session-token"

# AWS RDS Postgres configuration
PGHOST="your-db-host.amazonaws.com"
PGPORT="5432"
PGUSER="your_db_user"
PGDATABASE="your_database"
AWS_ROLE_ARN="arn:aws:iam::123456789012:role/your-role"
